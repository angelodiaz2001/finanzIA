# Copia este archivo a .env y ajusta los valores. El archivo .env NO se sube a git.

# Base de datos. Con docker compose up -d se levanta MySQL con estas credenciales.
# Si eliminas esta línea (o no existe .env) el backend usa SQLite local (finanzia.db).
DATABASE_URL=mysql+pymysql://finanzia:finanzia@localhost:3306/finanzia?charset=utf8mb4

# APIs simuladas (127.0.0.1 evita la espera por IPv6 que provoca "localhost" en Windows)
BANK_API_URL=http://127.0.0.1:8001
WALLET_API_URL=http://127.0.0.1:8002
NOTIFICATIONS_API_URL=http://127.0.0.1:8003

# Frontend permitido por CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_CURRENCY=PEN

# Reglas de integración
NOTIFICATION_MIN_CONFIDENCE=0.6
DEDUP_WINDOW_HOURS=36
DEDUP_SIMILARITY_THRESHOLD=0.5

# IA generativa (opcional). Sin clave, el asistente indica que no está configurado
# y el resto de la aplicación funciona con normalidad.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_SERVER_FALLBACK=true
